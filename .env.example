# Copy to .env and fill in.  (.env is gitignored — never commit real secrets.)

# Panel unlock password — CHANGE THIS before exposing the panel.
APP_PASSWORD=change-me

# Stable session secret so logins survive restarts. Any long random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the panel listens on.
PORT=3000

# Uncomment only if serving over HTTPS (enables Secure cookies + wss).
# NODE_ENV=production

# Max bots per user (default 20).
# MAX_BOTS_PER_USER=20
