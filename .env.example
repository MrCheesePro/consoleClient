# Copy to .env and fill in.  (.env is gitignored — never commit real secrets.)

# Panel unlock password — CHANGE THIS before exposing the panel.
APP_PASSWORD=change-me

# Stable session secret so logins survive restarts. Any long random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the panel listens on. Change if 3000 is already used on the VPS.
PORT=3000

# Interface to bind. Set 127.0.0.1 on a shared VPS so the panel is reachable ONLY over an
# SSH tunnel (never on the public IP). Leave as 0.0.0.0 for local use.
HOST=0.0.0.0

# Uncomment only if serving over HTTPS (enables Secure cookies + wss).
# NODE_ENV=production

# Max bots per user (default 20).
# MAX_BOTS_PER_USER=20
